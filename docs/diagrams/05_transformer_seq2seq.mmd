flowchart TB
    SEQ["Secuencia de snapshots [G_t-T+1 ... G_t]"]

    subgraph SP["1 · Codificador espacial (SpatialGATEncoder)"]
        direction TB
        PROJ["Proyeccion GATv2Conv<br/>input_dim -> hidden_dim"]
        RES["Bloques residuales pre-norm x (L-1)<br/>LayerNorm -> GATv2Conv -> GELU -> Dropout<br/>x = x + h  (anti over-smoothing)"]
        PROJ --> RES
    end

    STACK["Apilado [N, T, d]"]
    POS["Positional encoding sinusoidal<br/>sobre el eje temporal T"]

    subgraph TE["2 · Codificador temporal"]
        TENC["TransformerEncoder pre-norm<br/>x num_temporal_layers<br/>self-attention sobre T"]
    end

    subgraph DEC["3 · Decoder por horizonte"]
        direction TB
        Q["Queries aprendibles<br/>[num_horizons, d]"]
        XATTN["MultiheadAttention<br/>query=horizontes, key/value=temporal<br/>+ residual + LayerNorm"]
        Q --> XATTN
    end

    HEAD["Cabeza MLP por (nodo, horizonte)<br/>Linear -> GELU -> Dropout -> Linear<br/>=> output_channels"]
    OUT["[N, H]  o  [N, H, 3]<br/>sin autoregresion ni teacher forcing"]

    SEQ --> SP
    RES --> STACK
    STACK --> POS
    POS --> TENC
    TENC --> XATTN
    XATTN --> HEAD
    HEAD --> OUT
